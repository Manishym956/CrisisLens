# ==========================================
# CrisisLens - Environment Variables Template
# ==========================================

# 1. Database Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=crisislens

# 2. AI Verification & Prediction Engine APIs
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 3. Automation & Alerting Webhooks (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# 4. Email Automation (Optional - for Alerting)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# 5. Application Settings
PROJECT_NAME="CrisisLens API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# 6. OAuth & Security
GOOGLE_CLIENT_ID=your_google_client_id_here
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# 7. Email Dispatch — Ranks 1-2 (Critical threats)
# Gmail: enable 2FA → Google Account → App Passwords → generate one
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx     # 16-char Gmail App Password
ALERT_EMAIL_RECIPIENTS=authority@gov.in,press@agency.com  # comma-separated

# 8. Reddit Dispatch — Ranks 3-6 (High/Medium threats)
# Reddit: go to reddit.com/prefs/apps → Create App (script type) → copy client_id & secret
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_SUBREDDIT=CrisisLensAlerts    # subreddit name WITHOUT r/
